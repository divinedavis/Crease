[Unit]
Description=Crease dispatch service (courier orchestration + provider webhooks)
After=network-online.target
Wants=network-online.target

[Service]
# Unprivileged: this process holds the service-role, Stripe and Uber keys and
# terminates public webhooks, so running it as root made any RCE a full-box
# compromise on a droplet shared with six other sites.
User=crease
Group=crease
Type=simple
WorkingDirectory=/opt/crease/services/dispatch
ExecStart=/usr/bin/node --enable-source-maps dist/index.js
Restart=always
RestartSec=3

# Bound to loopback; nginx terminates TLS and proxies. Never expose this
# port directly — it holds the Supabase service-role key in memory.
Environment=HOST=127.0.0.1
Environment=PORT=8011
Environment=NODE_ENV=production

# The box is shared with five other sites and has ~1GB free. Cap the heap so
# a runaway here cannot OOM findacrib or NEMO alongside it.
Environment=NODE_OPTIONS=--max-old-space-size=192
MemoryMax=320M

StandardOutput=append:/var/log/crease/dispatch.log
StandardError=append:/var/log/crease/dispatch.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# The process needs nothing from /home, no elevated caps (it binds a port above
# 1024), and only inet/unix sockets. @system-service is systemd's baseline
# syscall set for long-running services — Node runs cleanly under it, and it
# blocks the swapon/reboot/keyctl/etc. classes an RCE would reach for.
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
