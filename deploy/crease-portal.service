[Unit]
Description=Crease cleaner portal (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
# Unprivileged: this process holds the service-role, Stripe and Uber keys and
# terminates public webhooks, so running it as root made any RCE a full-box
# compromise on a droplet shared with six other sites.
User=crease
Group=crease
Type=simple
WorkingDirectory=/opt/crease/apps/portal
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
Environment=NODE_ENV=production
# The only origin the portal trusts for redirects and Stripe return URLs.
# Unset, both fall back to request headers, which a caller controls.
Environment=PORTAL_PUBLIC_URL=https://portal.usecreaseapp.com

Environment=NODE_OPTIONS=--max-old-space-size=256
MemoryMax=420M

StandardOutput=append:/var/log/crease/portal.log
StandardError=append:/var/log/crease/portal.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Same confinement as the dispatcher: no /home, no caps, inet/unix sockets only,
# systemd's baseline service syscall set.
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
