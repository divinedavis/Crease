# Copy to asc-config.env and fill in. Gitignored.
ASC_KEY_ID=YOUR_KEY_ID
ASC_ISSUER_ID=YOUR_ISSUER_ID
ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_YOUR_KEY_ID.p8"
ASC_TEAM_ID=YOUR_TEAM_ID
ASC_BUNDLE_ID=com.divinedavis.crease
ASC_APP_NAME="Crease"
# Review contact shown to App Store review (not published on the listing).
ASC_CONTACT_FIRST_NAME=Jane
ASC_CONTACT_LAST_NAME=Doe
ASC_CONTACT_PHONE=+1 555 555 5555
ASC_CONTACT_EMAIL=you@example.com
