node_modules/
dist/
.next/
.env
.env.local
*.log
.DS_Store
build/
DerivedData/
*.xcuserstate
xcuserdata/
.supabase/
apps/ios/Secrets.xcconfig
apps/ios/build/

scripts/asc-config.env
apps/ios/build/
apps/ios/*.xcarchive
apps/ios/*.ipa

# iCloud dedup duplicates. ~/Desktop is synced, so an edited project can
# reappear as 'Crease 2.xcodeproj'. xcodebuild then fails with
# "contains N projects" and picks the wrong one.
*[0-9].xcodeproj/
* [0-9].xcodeproj/
*.nosync

# Raw simulator captures — regenerate with scripts/marketing-shots.sh.
# The composed panels are committed; the inputs are not, since they carry
# whatever test data happened to be seeded that day.
apps/ios/marketing/raw/
*.tsbuildinfo

# Growth engine runtime.
#
# growth.env holds live credentials and this repository is PUBLIC.
# results.jsonl and state.json are the droplet's own measurement history: it is
# their only writer, they are republished in aggregate as growth/snapshot.json,
# and a stale checkout pushing over them would erase the record the whole
# review loop is judged on.
#
# techniques.json and keywords.json are deliberately NOT here. They are the
# ledger, and the ledger is how the cloud review agent steers the engine —
# flipping a technique to retired is a one-line commit with no deploy.
growth.env
growth/results.jsonl
growth/state.json
growth/.anthropic_key
growth/*.tmp

# The site's published guides live on the droplet, are written by the engine,
# and cannot be rebuilt from this repo. deploy/deploy.sh excludes the same path
# from its rsync --delete for the same reason.
apps/web/content/

# Python bytecode from the droplet checkout.
__pycache__/
*.pyc

# Service-account keys and APNs certificates. The droplet keeps these under
# secrets/ and deploy.sh already excludes the directory from rsync, but nothing
# stopped git from committing one — and this repository is public.
secrets/
*.p8
.gsc_key.json
gsc-service-account.json
