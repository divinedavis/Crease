// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored.
// The anon key is a public client credential protected by RLS; it is kept
// out of git only so the repo stays portable and the key can rotate
// without a code change.

SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
