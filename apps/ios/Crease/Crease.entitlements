<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sign in with Apple. The capability on the App ID and this entitlement
       are two halves of the same thing: without both, the button renders but
       authorization fails at runtime in a signed build — and it works fine in
       the simulator, so it is invisible until TestFlight. -->
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>

  <!-- Apple Pay is deliberately absent for now.
       The merchant id (merchant.com.divinedavis.crease) exists and the
       APPLE_PAY capability is enabled on the App ID, but Apple does not expose
       *attaching* a merchant to that capability through the App Store Connect
       API — it is a checkbox in the developer portal only. Until that is
       ticked, any profile issued omits the merchant and the build fails with
       "profile doesn't match the entitlements file".

       Re-add once attached:
         <key>com.apple.developer.in-app-payments</key>
         <array><string>merchant.com.divinedavis.crease</string></array>

       PaymentSheet still takes cards in the meantime; it simply does not offer
       the Apple Pay button. -->
</dict>
</plist>
