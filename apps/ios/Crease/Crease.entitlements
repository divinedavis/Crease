<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sign in with Apple. The capability on the App ID and this entitlement
       are two halves of the same thing: without both, the button renders but
       authorization fails at runtime in a signed build — and it works fine in
       the simulator, so it is invisible until TestFlight. -->
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>

  <!-- Apple Pay needs three things, all of them, or the button never appears:
       the merchant identifier below, the APPLE_PAY capability on the App ID,
       and that merchant attached to the capability. The attachment is a
       checkbox in the developer portal — App Store Connect's API does not
       expose it, and a profile issued before it is ticked omits the merchant
       and fails the build with "profile doesn't match the entitlements file". -->
  <key>com.apple.developer.in-app-payments</key>
  <array>
    <string>merchant.com.divinedavis.crease</string>
  </array>

  <!-- Push Notifications. The value is a build setting (see project.yml) and
       not a literal, because the two configurations talk to two different
       APNs: a Debug build registers against sandbox, and anything signed for
       distribution — TestFlight included — registers against production. A
       build that claims the wrong one still gets a device token, and every
       send against it is refused at Apple with a bad-token error the app never
       sees. The App ID needs the Push Notifications capability enabled too, or
       the issued profile omits this key and signing fails outright. -->
  <key>aps-environment</key>
  <string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
