<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sign in with Apple. The capability on the App ID and this entitlement
       are two halves of the same thing: without both, the button renders but
       authorization fails at runtime in a signed build — and it works fine in
       the simulator, so it is invisible until TestFlight. -->
  <key>com.apple.developer.applesignin</key>
  <array>
    <string>Default</string>
  </array>

  <!-- Apple Pay. The merchant identifier must exist in the developer account
       and be attached to the App ID's Apple Pay capability; the entitlement on
       its own produces a sheet that never appears. -->
  <key>com.apple.developer.in-app-payments</key>
  <array>
    <string>merchant.com.divinedavis.crease</string>
  </array>
</dict>
</plist>
