# ---- dispatch service ----
PORT=8080
PUBLIC_URL=https://dispatch.example.com
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # service role — server only, never ship to a client
INTERNAL_API_KEY=                # shared secret for portal/iOS -> dispatch

# ---- mock courier (development) ----
ENABLE_MOCK_COURIER=true
MOCK_SPEED_FACTOR=20             # 20 => a 38s delivery finishes in ~2s
MOCK_FAILURE_RATE=0              # 0.2 => 20% of legs end 'returned'
MOCK_WEBHOOK_SECRET=

# ---- Uber Direct (fill in when Uber approves sandbox access) ----
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
UBER_WEBHOOK_SECRET=
UBER_API_BASE=https://api.uber.com/v1

# ---- cleaner portal (apps/portal/.env.local) ----
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # anon key — safe in the browser, RLS gates it
DISPATCH_URL=http://localhost:8080
INTERNAL_API_KEY=                 # must match the dispatch service

# ---- payments ----
STRIPE_SECRET_KEY=                # sk_test_... ; unset falls back to the mock provider
# Handed to the app so it can present the payment sheet. Public by design, but
# it MUST match the secret key's mode — a live publishable against a test
# secret fails at the sheet with a misleading "no such payment intent".
STRIPE_PUBLISHABLE_KEY=           # pk_test_...
ENABLE_MOCK_PAYMENTS=             # 'true' forces the mock even when Stripe is configured

# ---- local scripts ----
# Password for the seeded test accounts. Not committed: this repo is
# public and the Supabase project it points at is live.
CREASE_TEST_PASSWORD=
# Deploy target, e.g. root@203.0.113.10
CREASE_HOST=
